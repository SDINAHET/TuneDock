{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "2.1.4",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["https://open.spotify.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/tunedock-16.png",
    "32": "icons/tunedock-32.png",
    "48": "icons/tunedock-48.png",
    "128": "icons/tunedock-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-web.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/tunedock-16.png",
      "32": "icons/tunedock-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [{
    "resources": ["assets/spotify-full-logo-white.svg", "_locales/*/messages.json"],
    "matches": ["https://*/*"]
  }]
}
