{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "version": "2.1.6",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "tunedock@loto-tracker.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://open.spotify.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/tunedock-16.png",
    "32": "icons/tunedock-32.png",
    "48": "icons/tunedock-48.png",
    "128": "icons/tunedock-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-web.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/tunedock-16.png",
      "32": "icons/tunedock-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "__MSG_actionTitle__",
    "default_panel": "sidepanel.html",
    "default_icon": "icons/tunedock-48.png",
    "open_at_install": false
  },
  "web_accessible_resources": [{
    "resources": ["assets/spotify-full-logo-white.svg", "_locales/*/messages.json"],
    "matches": ["https://*/*"]
  }]
}
