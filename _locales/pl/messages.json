  },
  "privacyLocalTitle": {
    "message": "Dane używane lokalnie"
  },
  "privacyLocalBody": {
    "message": "TuneDock odczytuje widoczne informacje o odtwarzaczu Spotify Web — tytuł, wykonawca, grafika, odtwarzanie, pozycja, głośność i stan sterowania — tylko w celu wyświetlenia i sterowania odtwarzaniem żądanym przez użytkownika."
  },
  "privacyStorageTitle": {
    "message": "Pamięć Chrome"
  },
  "privacyStorageBody": {
    "message": "Preferencje, pozycja widżetu i status włączenia są przechowywane lokalnie w profilu Chrome. Nie jest przechowywany żaden identyfikator Spotify, hasło ani token OAuth."
  },
  "privacyWidgetTitle": {
    "message": "Opcjonalny widget"
  },
  "privacyWidgetBody": {
    "message": "Dostęp do strony HTTPS jest żądany tylko wtedy, gdy użytkownik włączy widget. Widżet nie czyta zawartości strony, formularzy ani historii przeglądania; wyświetla tylko elementy sterujące TuneDock."
  },
  "privacyThirdTitle": {
    "message": "Usługi stron trzecich"
  },
  "privacyThirdBody": {
    "message": "TuneDock komunikuje się wyłącznie z Spotify Web poprzez HTTPS w celu wykonania żądanych działań. Korzystanie z Spotify podlega warunkom Spotify."
  },
  "privacyLyricsTitle": {
    "message": "Opcjonalne wyszukiwanie tekstów"
  },
  "privacyLyricsBody": {
    "message": "Po wyraźnym kliknięciu TuneDock może otworzyć wyszukiwarkę Google zawierającą tytuł i wykonawcę. TuneDock nie kontaktuje się z Google w tle, nie pobiera wyników, nie przechowuje ani nie odtwarza tekstów."
  },
