  "privacyLocalTitle": {
    "message": "Data används lokalt"
  },
  "privacyLocalBody": {
    "message": "TuneDock läser synlig Spotify Web-spelarinformation – titel, artist, konstverk, uppspelning, position, volym och kontrollstatus – endast för att visa och kontrollera uppspelning som begärs av användaren."
  },
  "privacyStorageTitle": {
    "message": "Chrome lagring"
  },
  "privacyStorageBody": {
    "message": "Inställningar, widgetposition och onboarding-status lagras lokalt i Chrome-profilen. Ingen Spotify-identifierare, lösenord eller OAuth-token lagras."
  },
  "privacyWidgetTitle": {
    "message": "Valfri widget"
  },
  "privacyWidgetBody": {
    "message": "HTTPS sidåtkomst begärs endast när användaren aktiverar widgeten. Widgeten läser inte sidinnehåll, formulär eller webbhistorik; den visar bara TuneDock kontroller."
  },
  "privacyThirdTitle": {
    "message": "Tredjepartstjänster"
  },
  "privacyThirdBody": {
    "message": "TuneDock kommunicerar endast med Spotify Web över HTTPS för att utföra begärda åtgärder. Användning av Spotify förblir föremål för Spotify:s villkor."
  },
  "privacyLyricsTitle": {
    "message": "Valfri textsökning"
  },
  "privacyLyricsBody": {
    "message": "Efter ett uttryckligt klick kan TuneDock öppna en Google-sökning som innehåller titeln och artisten. TuneDock kontaktar inte Google i bakgrunden, hämtar resultat, lagrar eller reproducerar sångtexter."
  },
