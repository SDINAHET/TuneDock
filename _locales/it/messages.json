  "privacyNotice": {
    "message": "TuneDock non raccoglie, vende o condivide dati personali. Non ha server, pubblicità o analisi."
  },
  "privacyLocalTitle": {
    "message": "Dati utilizzati localmente"
  },
  "privacyLocalBody": {
    "message": "TuneDock legge le informazioni visibili del lettore Spotify Web (titolo, artista, grafica, riproduzione, posizione, volume e stato di controllo) solo per visualizzare e controllare la riproduzione richiesta dall'utente."
  },
  "privacyStorageTitle": {
    "message": "Spazio di archiviazione Chrome"
  },
  "privacyStorageBody": {
    "message": "Le preferenze, la posizione del widget e lo stato di onboarding sono archiviati localmente nel profilo Chrome. Non viene memorizzato alcun identificatore Spotify, password o token OAuth."
  },
  "privacyWidgetTitle": {
    "message": "Widget opzionale"
  },
  "privacyWidgetBody": {
    "message": "L'accesso alla pagina HTTPS è richiesto solo quando l'utente abilita il widget. Il widget non legge il contenuto della pagina, i moduli o la cronologia di navigazione; visualizza solo i controlli TuneDock."
  },
  "privacyThirdTitle": {
    "message": "Servizi di terze parti"
  },
  "privacyThirdBody": {
    "message": "TuneDock comunica solo con Spotify Web su HTTPS per eseguire le azioni richieste. L'utilizzo di Spotify rimane soggetto ai termini di Spotify."
  },
  "privacyLyricsTitle": {
    "message": "Ricerca testi opzionale"
  },
  "privacyLyricsBody": {
    "message": "Dopo un clic esplicito, TuneDock può aprire una ricerca su Google contenente il titolo e l'artista. TuneDock non contatta Google in background, recupera risultati, memorizza o riproduce testi."
  },
