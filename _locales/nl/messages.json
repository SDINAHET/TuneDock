  "privacyPageTitle": {
    "message": "TuneDock for Spotify Privacy"
  },
  "privacyUpdated": {
    "message": "Laatst bijgewerkt: 9 augustus 2026"
  },
  "privacyNotice": {
    "message": "TuneDock verzamelt, verkoopt of deelt geen persoonlijke gegevens. Het heeft geen server, advertenties of analyses."
  },
  "privacyLocalTitle": {
    "message": "Gegevens lokaal gebruikt"
  },
  "privacyLocalBody": {
    "message": "TuneDock leest zichtbare Spotify Web-spelerinformatie - titel, artiest, artwork, afspelen, positie, volume en bedieningsstatus - alleen om het afspelen op verzoek van de gebruiker weer te geven en te regelen."
  },
  "privacyStorageTitle": {
    "message": "Chrome-opslag"
  },
  "privacyStorageBody": {
    "message": "Voorkeuren, widgetpositie en onboardingstatus worden lokaal opgeslagen in het Chrome-profiel. Er wordt geen Spotify-identificatie, wachtwoord of OAuth-token opgeslagen."
  },
  "privacyWidgetTitle": {
    "message": "Optionele widget"
  },
  "privacyWidgetBody": {
    "message": "HTTPS-paginatoegang wordt alleen gevraagd wanneer de gebruiker de widget inschakelt. De widget leest geen pagina-inhoud, formulieren of browsegeschiedenis; het geeft alleen TuneDock-bedieningselementen weer."
  },
  "privacyThirdTitle": {
    "message": "Diensten van derden"
  },
  "privacyThirdBody": {
    "message": "TuneDock communiceert alleen met Spotify Web via HTTPS om de gevraagde acties uit te voeren. Het gebruik van Spotify blijft onderworpen aan de voorwaarden van Spotify."
  },
  "privacyLyricsTitle": {
    "message": "Optioneel zoeken naar songteksten"
  },
  "privacyLyricsBody": {
    "message": "Na een expliciete klik kan TuneDock een Google-zoekopdracht openen met de titel en artiest. TuneDock maakt geen contact met Google op de achtergrond, haalt geen resultaten op, slaat geen songteksten op of reproduceert deze niet."
  },
