  "privacyNotice": {
    "message": "TuneDock não coleta, vende ou compartilha dados pessoais. Não possui servidor, publicidade ou análises."
  },
  "privacyLocalTitle": {
    "message": "Dados usados localmente"
  },
  "privacyLocalBody": {
    "message": "TuneDock lê informações visíveis do player Spotify Web - título, artista, arte, reprodução, posição, volume e status de controle - apenas para exibir e controlar a reprodução solicitada pelo usuário."
  },
  "privacyStorageTitle": {
    "message": "Armazenamento Chrome"
  },
  "privacyStorageBody": {
    "message": "Preferências, posição do widget e status de integração são armazenados localmente no perfil Chrome. Nenhum identificador Spotify, senha ou token OAuth é armazenado."
  },
  "privacyWidgetTitle": {
    "message": "Widget opcional"
  },
  "privacyWidgetBody": {
    "message": "O acesso à página HTTPS é solicitado somente quando o usuário ativa o widget. O widget não lê o conteúdo da página, formulários ou histórico de navegação; ele exibe apenas controles TuneDock."
  },
  "privacyThirdTitle": {
    "message": "Serviços de terceiros"
  },
  "privacyThirdBody": {
    "message": "TuneDock se comunica apenas com Spotify Web por meio de HTTPS para executar as ações solicitadas. O uso de Spotify permanece sujeito aos termos de Spotify."
  },
  "privacyLyricsTitle": {
    "message": "Pesquisa opcional de letras"
  },
  "privacyLyricsBody": {
    "message": "Após um clique explícito, TuneDock pode abrir uma pesquisa no Google contendo o título e o artista. TuneDock não entra em contato com o Google em segundo plano, não recupera resultados, armazena ou reproduz letras."
  },
