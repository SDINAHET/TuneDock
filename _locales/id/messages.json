  "privacyNotice": {
    "message": "TuneDock tidak mengumpulkan, menjual atau membagikan data pribadi. Ia tidak memiliki server, iklan, atau analitik."
  },
  "privacyLocalTitle": {
    "message": "Data digunakan secara lokal"
  },
  "privacyLocalBody": {
    "message": "TuneDock membaca informasi pemutar Spotify Web yang terlihat — judul, artis, karya seni, pemutaran, posisi, volume, dan status kontrol — hanya untuk menampilkan dan mengontrol pemutaran yang diminta oleh pengguna."
  },
  "privacyStorageTitle": {
    "message": "Penyimpanan Chrome"
  },
  "privacyStorageBody": {
    "message": "Preferensi, posisi widget, dan status orientasi disimpan secara lokal di profil Chrome. Tidak ada pengidentifikasi Spotify, kata sandi atau token OAuth yang disimpan."
  },
  "privacyWidgetTitle": {
    "message": "Widget opsional"
  },
  "privacyWidgetBody": {
    "message": "Akses halaman HTTPS diminta hanya ketika pengguna mengaktifkan widget. Widget tidak membaca konten halaman, formulir, atau riwayat penelusuran; itu hanya menampilkan kontrol TuneDock."
  },
  "privacyThirdTitle": {
    "message": "Layanan pihak ketiga"
  },
  "privacyThirdBody": {
    "message": "TuneDock hanya berkomunikasi dengan Spotify Web melalui HTTPS untuk melakukan tindakan yang diminta. Penggunaan Spotify tetap tunduk pada ketentuan Spotify."
  },
  "privacyLyricsTitle": {
    "message": "Pencarian lirik opsional"
  },
  "privacyLyricsBody": {
    "message": "Setelah diklik secara eksplisit, TuneDock dapat membuka pencarian Google yang berisi judul dan artis. TuneDock tidak menghubungi Google di latar belakang, mengambil hasil, menyimpan atau mereproduksi lirik."
  },
