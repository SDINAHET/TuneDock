  "privacyPageTitle": {
    "message": "TuneDock for Spotify Privacy"
  },
  "privacyUpdated": {
    "message": "Last updated: August 9, 2026"
  },
  "privacyNotice": {
    "message": "TuneDock does not collect, sell or share personal data. It has no server, advertising or analytics."
  },
  "privacyLocalTitle": {
    "message": "Data used locally"
  },
  "privacyLocalBody": {
    "message": "TuneDock reads visible Spotify Web player information — title, artist, artwork, playback, position, volume and control status — only to display and control playback requested by the user."
  },
  "privacyStorageTitle": {
    "message": "Chrome storage"
  },
  "privacyStorageBody": {
    "message": "Preferences, widget position and onboarding status are stored locally in the Chrome profile. No Spotify identifier, password or OAuth token is stored."
  },
  "privacyWidgetTitle": {
    "message": "Optional widget"
  },
  "privacyWidgetBody": {
    "message": "HTTPS page access is requested only when the user enables the widget. The widget does not read page content, forms or browsing history; it only displays TuneDock controls."
  },
  "privacyThirdTitle": {
    "message": "Third-party services"
  },
  "privacyThirdBody": {
    "message": "TuneDock communicates only with Spotify Web over HTTPS to perform requested actions. Spotify use remains subject to Spotify's terms."
  },
  "privacyLyricsTitle": {
    "message": "Optional lyrics search"
  },
  "privacyLyricsBody": {
    "message": "After an explicit click, TuneDock can open a Google search containing the title and artist. TuneDock does not contact Google in the background, retrieve results, store or reproduce lyrics."
  },
